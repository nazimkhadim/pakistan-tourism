<!DOCTYPE html>
<html>
<head>
<title>Foods</title>
<link rel="stylesheet" href="/css/style.css">
</head>

<body>

<h1>Famous Pakistani Foods</h1>

<div class="container">

<% foods.forEach(food => { %>

<div class="card">
<img src="<%= food.image %>" width="200">
<h3><%= food.name %></h3>
<p><%= food.city %></p>
</div>

<% }) %>

</div>

<a href="/">Home</a>

</body>
</html>